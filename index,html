    <!-- ================= JAVASCRIPT INTERACTIVITY ================= -->
    <script>
        // State Management
        const loginSection = document.getElementById('login-section');
        const mainApp = document.getElementById('main-app');
        const loginForm = document.getElementById('login-form');
        const displayName = document.getElementById('display-name');
        const displayClass = document.getElementById('display-class');

        // Check local storage on load
        window.addEventListener('DOMContentLoaded', () => {
            const savedName = localStorage.getItem('eco_user_name');
            const savedClass = localStorage.getItem('eco_user_class');
            if (savedName && savedClass) {
                initApp(savedName, savedClass);
            }
        });

        // Login Handler
        loginForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = document.getElementById('user-name').value.trim();
            const studentClass = document.getElementById('user-class').value.trim();
            if(name && studentClass) {
                localStorage.setItem('eco_user_name', name);
                localStorage.setItem('eco_user_class', studentClass);
                initApp(name, studentClass);
            }
        });

        function initApp(name, studentClass) {
            displayName.textContent = name;
            displayClass.textContent = studentClass;
            loginSection.classList.add('hidden');
            mainApp.classList.remove('hidden');
            mainApp.classList.add('flex');
            switchTab('pendahuluan');
        }

        function logout() {
            localStorage.removeItem('eco_user_name');
            localStorage.removeItem('eco_user_class');
            mainApp.classList.add('hidden');
            mainApp.classList.remove('flex');
            loginSection.classList.remove('hidden');
            loginForm.reset();
        }

        // Tab Navigation Switcher
        function switchTab(tabId) {
            const tabs = document.querySelectorAll('.tab-content');
            tabs.forEach(tab => tab.classList.add('hidden'));

            const targetTab = document.getElementById(`section-${tabId}`);
            if(targetTab) {
                targetTab.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Update active state on nav buttons
            const navButtons = document.querySelectorAll('.nav-btn');
            navButtons.forEach(btn => {
                btn.classList.remove('text-emerald-700', 'bg-emerald-50', 'font-semibold');
                if(btn.getAttribute('data-target') === tabId) {
                    btn.classList.add('text-emerald-700', 'bg-emerald-50', 'font-semibold');
                }
            });
        }

        // Accordion Toggle
        function toggleAccordion(id) {
            const content = document.getElementById(id);
            const icon = document.getElementById(`icon-${id}`);
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        }

        // Mobile Menu Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Modal Iframe Handlers
        const mediaModal = document.getElementById('media-modal');
        const modalIframe = document.getElementById('modal-iframe');
        const modalTitle = document.getElementById('modal-title');

        function openModal(url, title) {
            modalTitle.textContent = title;
            modalIframe.src = url;
            mediaModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function openVideoModal(url) {
            openModal(url, 'Video Pembelajaran Pengantar Ekosistem');
        }

        function closeModal() {
            mediaModal.classList.add('hidden');
            modalIframe.src = '';
            document.body.style.overflow = 'auto';
        }

        // Close modal when clicking outside content area
        mediaModal.addEventListener('click', (e) => {
            if (e.target === mediaModal) {
                closeModal();
            }
        });
    </script>
