                <button onclick="switchTab('materi-b'); toggleMobileMenu();" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-emerald-50 hover:text-emerald-700">Bagian B: Interaksi</button>
